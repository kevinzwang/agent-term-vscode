{
  "name": "agent-terminal",
  "displayName": "Agent Terminal",
  "description": "Persistent terminal for agentic coding workflows",
  "version": "0.1.0",
  "publisher": "kevinwang",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "agentTerminalContainer",
          "title": "Agent Terminal",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "agentTerminalContainer": [
        {
          "type": "webview",
          "id": "agentTerminal",
          "name": "Agent Terminal"
        }
      ]
    },
    "commands": [
      {
        "command": "agentTerminal.newTab",
        "title": "New Agent Terminal",
        "icon": "$(plus)"
      },
      {
        "command": "agentTerminal.killTab",
        "title": "Kill Agent Terminal Tab",
        "icon": "$(trash)"
      },
      {
        "command": "agentTerminal.renameTab",
        "title": "Rename Agent Terminal Tab"
      },
      {
        "command": "agentTerminal.focusTerminal",
        "title": "Focus Agent Terminal"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentTerminal.newTab",
          "when": "view == agentTerminal",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "agentTerminal.renameTab",
          "when": "webviewId == 'agentTerminal'"
        },
        {
          "command": "agentTerminal.killTab",
          "when": "webviewId == 'agentTerminal'"
        }
      ]
    },
    "configuration": {
      "title": "Agent Terminal",
      "properties": {
        "agentTerminal.startupCommand": {
          "type": "string",
          "default": "",
          "description": "Command to run automatically when creating a new terminal tab"
        },
        "agentTerminal.scrollback": {
          "type": "number",
          "default": 5000,
          "description": "Number of lines to keep in scrollback buffer"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "build:prod": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "vsce package"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.115.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
"@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "node-pty": "^1.2.0-beta.12"
  }
}
